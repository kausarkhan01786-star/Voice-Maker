# Required by Google-powered speech and music features
GEMINI_API_KEY=your_gemini_api_key

# Required by the AI Copilot and Sora video generation (Sora access and billing required)
OPENAI_API_KEY=your_openai_api_key

# Optional; defaults to sora-2
OPENAI_VIDEO_MODEL=sora-2

# Optional public app URL
APP_URL=http://localhost:3000
